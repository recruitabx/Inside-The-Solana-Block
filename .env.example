# Copy to .env and fill in. .env is git-ignored.
# RPC endpoint used for sending and reading (may contain an API key: never commit it).
RPC_URL=https://api.mainnet-beta.solana.com
# Optional separate endpoint for `verify` (defaults to the public mainnet endpoint).
VERIFY_RPC_URL=
# Live sending is OFF unless this is exactly 1 AND you run the `live` service.
ITB_LIVE=0
# Total fee cap in lamports. Code refuses anything above 50000000 (0.05 SOL).
ITB_SPEND_CAP_LAMPORTS=50000000
# Path on the host to the funding wallet (Solana CLI JSON keypair, chmod 600). Mounted read-only.
ITB_WALLET_FILE=./secrets/wallet.json
